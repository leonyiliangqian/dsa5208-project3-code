#!/bin/bash
# Two-node correctness job: ranks on two distinct compute hosts, placement
# inside each node's allocation, MPI data exchange between nodes, and hybrid
# results identical to serial with uneven ownership. Not a benchmark.
#
# Submit only through jobs/vanda/submit.sh (explicit queue and allocation).
# place=scatter forces the two chunks onto different nodes.
#
#PBS -N p3_twonode
#PBS -l select=2:ncpus=8:mpiprocs=8:mem=16gb
#PBS -l place=scatter
#PBS -l walltime=00:30:00
#PBS -j oe

set -uo pipefail
cd "${PBS_O_WORKDIR:?run under PBS, from the code/ directory}"

JOB=${PBS_JOBID%%.*}
JOB_START_S=$(date +%s)
RUN_ID=${RUN_ID:-twonode-$(date -u +%Y%m%dT%H%M%SZ)-$JOB}
OUT=${RUNS_ROOT:-artifacts/cluster/runs}/$RUN_ID
mkdir -p "$OUT/env"
exec > >(tee "$OUT/job.log") 2>&1
echo "run_id=$RUN_ID job=${PBS_JOBID} host=$(hostname) start=$(date -Is) source_rev=${SOURCE_GIT_REV:-unset}"

# tm launches with binding hang on Vanda (job 1514029). REQUIRE_PBS_TM=0 is local simulation.
[ "${REQUIRE_PBS_TM:-1}" = 1 ] && export MPI_LAUNCHER=${MPI_LAUNCHER:-pbs_tmrsh}
source jobs/vanda/multinode_setup.sh

# ---------------------------------------------------------------- gates
BIN=bin/vanda-$JOB
# Portable target for this mixed-model correctness job: one binary built on
# the head node runs on both nodes without relying on a comparison of CPU
# flags. Serial and hybrid builds both take CXXFLAGS (see the Makefile).
# Benchmarks use -march=native on a single CPU model instead.
export CXXFLAGS="-O3 -std=c++17 -Wall -Wextra -march=x86-64 -mtune=generic"
export OUT BIN MPI
# Time limits are about 10x the durations seen on Vanda (job 1503779 ran all
# its gates in 70 s; the hybrid gate, the longest, in 38 s).
WALLTIME_S=$(sed -n 's/^#PBS -l walltime=\([0-9]*\):\([0-9]*\):\([0-9]*\).*/\1 \2 \3/p' "$0" \
             | awk '{print $1*3600 + $2*60 + $3}')
WALLTIME_S=${WALLTIME_S:-1800}
LEFTOVER_PATTERN="vanda-$JOB/"
export LEFTOVER_JOBID=${PBS_JOBID:-}
source jobs/vanda/gates.sh
echo "walltime_s=$WALLTIME_S end_reserve_s=$END_RESERVE_S gate_overhead_s=$(gate_overhead_s) remote_exec=$REMOTE_EXEC"

# Fail fast: without two distinct hosts, the expected 8 CPUs per node and a
# verified PBS launch, nothing after this point would mean what it claims;
# the failed check's output stays in gate_allocation.log, env/ and gates.txt.
gate allocation   90 critical env ALLOC_EXPECT_NODES=2 ALLOC_CPUS_PER_NODE=8 \
    bash jobs/vanda/allocation_check.sh "$OUT" "$NODES" "$LAUNCH"
gate build       240 critical make BIN="$BIN" all hybrid
gate flags        60 critical bash jobs/vanda/flags_check.sh
gate toolchain    90 critical make BIN="$BIN" toolchain
gate internode_2  90 critical make BIN="$BIN" MPIRUN="$MPI" internode INTERNODE_NP=2 INTERNODE_HOSTS=2
gate internode_16 90 required make BIN="$BIN" MPIRUN="$MPI" internode INTERNODE_NP=16 INTERNODE_HOSTS=2
# Repeated because one passing launch in job 1514029 says little about reliability.
gate place_2x4_1  60 required make BIN="$BIN" MPIRUN="$MPI" placement PLACE_NODES=2 PLACE_R=2 PLACE_T=4
gate place_2x4_2  60 required make BIN="$BIN" MPIRUN="$MPI" placement PLACE_NODES=2 PLACE_R=2 PLACE_T=4
gate place_2x4_3  60 required make BIN="$BIN" MPIRUN="$MPI" placement PLACE_NODES=2 PLACE_R=2 PLACE_T=4
gate place_4x2    60 required make BIN="$BIN" MPIRUN="$MPI" placement PLACE_NODES=2 PLACE_R=4 PLACE_T=2
gate place_8x1    60 required make BIN="$BIN" MPIRUN="$MPI" placement PLACE_NODES=2 PLACE_R=8 PLACE_T=1
gate serial      240 required make BIN="$BIN" EVIDENCE="$OUT" check
# Round-robin mapping spreads every multi-rank case over both nodes; the gate
# requires each such run to report two hosts. It compares against the serial
# program, so it is only meaningful once the serial gate has passed.
need serial hybrid required && \
gate hybrid      600 required make BIN="$BIN" EVIDENCE="$OUT" check-hybrid MPIRUN=mpirun \
                      MPIRUN_FLAGS="${MPI#mpirun } -x OMP_NUM_THREADS --map-by node --bind-to none" \
                      HYBRID_GATE_ARGS="--max-cores 16 --suite multinode --expect-hosts 2"
# Same ppr:2:node:PE=4 mapping as place_2x4.
need place_2x4_3 recorder required && \
gate recorder    120 required env OMP_NUM_THREADS=4 OMP_PROC_BIND=close OMP_PLACES=cores \
    python3 scripts/run_case.py --out "$OUT" --case smoke_bound_2node_4x4 --rep 1 --allocated-cores 16 \
    --launcher "$MPI -np 4 --map-by ppr:2:node:PE=4 --bind-to core -x OMP_NUM_THREADS -x OMP_PROC_BIND -x OMP_PLACES" \
    -- "$BIN/bh_hybrid" --n 50000 --steps 2 --schedule dynamic --chunk 64
# Last: the mapping that hung under tm in jobs 1507215 and 1514029 (one rank per node,
# PE=8 = the whole per-node cpuset). Each attempt is bounded and the job continues.
gate place_1x8_1  60 required make BIN="$BIN" MPIRUN="$MPI" placement PLACE_NODES=2 PLACE_R=1 PLACE_T=8
gate place_1x8_2  60 required make BIN="$BIN" MPIRUN="$MPI" placement PLACE_NODES=2 PLACE_R=1 PLACE_T=8
gate place_1x8_3  60 required make BIN="$BIN" MPIRUN="$MPI" placement PLACE_NODES=2 PLACE_R=1 PLACE_T=8

verdict >/dev/null && finish 0
finish 1
