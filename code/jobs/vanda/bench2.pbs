#!/bin/bash
# Formal two-node (128-core) measurements from a FROZEN manifest (default
# manifests/studies_two_node.json, still proposed). Blocked until two-node
# correctness passes. Both nodes must be one CPU model (allocation gate).
# The walltime is a placeholder to be set from pilot timings before approval.
# Submit only after approval, through jobs/vanda/submit.sh.
#
#PBS -N p3_bench2
#PBS -l select=2:ncpus=64:mpiprocs=64:mem=120gb
#PBS -l place=scatter
#PBS -l walltime=01:00:00
#PBS -j oe

RUN_PREFIX=bench2
MANIFEST=${MANIFEST:-manifests/studies_two_node.json}
EXPECT_NODES=2 CPUS_PER_NODE=${SIM_CPUS_PER_NODE:-64} PLACE_R=8 PLACE_T=8
REQUIRE_FROZEN=1
# PBS starts a job in $HOME, so this relative path needs the cd (job 1514774).
cd "${PBS_O_WORKDIR:?run under PBS, from the code/ directory}"
source jobs/vanda/measure.sh
