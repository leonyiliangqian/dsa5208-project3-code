#!/bin/bash
# Formal 1-256 core series from a FROZEN manifest (default
# manifests/studies_four_node.json, still proposed). The 256-core request does
# not fit cpu_parallel (160 CPUs per job and per user), so this job cannot use
# auto_free: it needs batch_cpu through `auto` with an approved --project, at
# charge rate 1. Blocked until two-node correctness passes and the charge is
# approved. All nodes must be one CPU model (allocation gate). Walltime and
# sizes are provisional: pilot4.pbs must pass first, then set them from its
# timings and recheck with scripts/plan_budget.py. SCALE_CHECKS (required by
# Leon, 6 Nov) runs the 64 x 1 per-node placement probe, the bound exchange
# check and bound runs against serial on all 256 cores before any timing; the
# walltime must cover their time, measured on 4 nodes by pilot4. 3 h (10 Nov):
# worst case 9390 s of runs plus 600 s of gates (pilot4 took 322 s) and the
# end reserve; expected about 1 h. Cap 256 cores x 3 h = 768 core-hours.
# Submit only after approval, through jobs/vanda/submit.sh.
#
#PBS -N p3_bench4
#PBS -l select=4:ncpus=64:mpiprocs=64:mem=240gb
#PBS -l place=scatter
#PBS -l walltime=03:00:00
#PBS -j oe

RUN_PREFIX=bench4
MANIFEST=${MANIFEST:-manifests/studies_four_node.json}
EXPECT_NODES=4 CPUS_PER_NODE=${SIM_CPUS_PER_NODE:-64} PLACE_R=8 PLACE_T=8
REQUIRE_FROZEN=1 SCALE_CHECKS=1
# PBS starts a job in $HOME, so this relative path needs the cd (job 1514774).
cd "${PBS_O_WORKDIR:?run under PBS, from the code/ directory}"
source jobs/vanda/measure.sh
